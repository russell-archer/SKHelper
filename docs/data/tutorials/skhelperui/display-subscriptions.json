:"\/tutorials\/skhelperui\/configure-products#Configuring-Productsplist","title":"Configuring Products.plist","role":"pseudoSymbol"},"quickstart-contentview4.swift":{"identifier":"quickstart-contentview4.swift","content":["import SwiftUI","import SKHelperUI","","struct ContentView: View {","    @Environment(SKHelper.self) private var store","    ","    var body: some View {","        VStack {","            SKHelperSubscriptionStoreView(","                subscriptionGroupName: \"vip\",","                subscriptionHeader: { header() },","                subscriptionControl: { productId in control(productId: productId) },","                subscriptionDetails: { productId in details(productId: productId) })","        }","    }","    ","    func header() -> some View {","        VStack {","            Image(\"plant-services\").resizable().scaledToFit()","            Text(\"Our top-rated services will make your plants happy\").font(.headline)","        }","    }","    ","    func control(productId: ProductId) -> some View {","        VStack {","            Image(productId).resizable().scaledToFit()","            Text(\"We'll water your plants \\(productId == \"com.rarcher.subscription.vip.gold\" ? \"weekly\" : \"monthly\").\").font(.callout)","        }","    }","    ","    func details(productId: ProductId) -> some View {","        VStack {","            Image(\"\\(productId).info\").resizable().scaledToFit()","            Text(\"Here is some text about why you might want to buy this product.\")","        }","        .padding()","    }","}"],"fileName":"ContentView.swift","syntax":"swift","type":"file","highlights":[],"fileType":"swift"},"doc://SKHelperUI/tutorials/SKHelperUI/display-products#Display-all-products":{"type":"section","abstract":[{"type":"text","text":"Add code to display all products and support user purchases."}],"identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/display-products#Display-all-products","url":"\/tutorials\/skhelperui\/display-products#Display-all-products","title":"Display all products","role":"pseudoSymbol","kind":"section"}}}