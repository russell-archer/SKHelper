helperui\/display-products","estimatedTime":"5min","title":"Display all products","role":"project","kind":"project"},"doc://SKHelperUI/tutorials/SKHelperUI/configure-products":{"type":"topic","abstract":[{"type":"text","text":"See how to configure in-app purchase products and Xcode purchase testing."}],"identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/configure-products","url":"\/tutorials\/skhelperui\/configure-products","estimatedTime":"5min","title":"Configure products","role":"project","kind":"project"},"doc://SKHelperUI/tutorials/SKHelperUI/check-purchase":{"type":"topic","abstract":[{"type":"text","text":"Check if the user has purchased a specific product."}],"identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/check-purchase","url":"\/tutorials\/skhelperui\/check-purchase","estimatedTime":"5min","title":"Check a purchase","role":"project","kind":"project"},"doc://SKHelperUI/tutorials/SKHelperUI/getting-started":{"type":"topic","abstract":[{"text":"How to get started with ","type":"text"},{"inlineContent":[{"type":"text","text":"SKHelper"}],"type":"strong"},{"type":"text","text":" by creating a simple demo app using SwiftUI."}],"identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/getting-started","url":"\/tutorials\/skhelperui\/getting-started","estimatedTime":"5min","title":"Getting Started","role":"project","kind":"project"},"doc://SKHelperUI/tutorials/SKHelperUI/configure-products#Configuring-product-images":{"kind":"section","identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/configure-products#Configuring-product-images","type":"section","abstract":[{"type":"text","text":"See how to configure in-app purchase products and Xcode purchase testing."}],"url":"\/tutorials\/skhelperui\/configure-products#Configuring-product-images","title":"Configuring product images","role":"pseudoSymbol"},"doc://SKHelperUI/tutorials/SKHelperUI/purchase-management#Manage-Subscriptions":{"abstract":[{"type":"text","text":"Learn how to manage purchases and subscriptions."}],"role":"pseudoSymbol","url":"\/tutorials\/skhelperui\/purchase-management#Manage-Subscriptions","type":"section","title":"Manage Subscriptions","identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/purchase-management#Manage-Subscriptions","kind":"section"},"Xcode 16.3+":{"url":"https:\/\/developer.apple.com\/download\/applications\/","type":"xcodeRequirement","identifier":"Xcode 16.3+","title":"Xcode 16.3+"},"doc://SKHelperUI/tutorials/quickstart/Configure-products":{"type":"topic","abstract":[],"identifier":"doc:\/\/SKHelperUI\/tutorials\/quickstart\/Configure-products","url":"\/tutorials\/quickstart\/configure-products","title":"Configure products","role":"article","kind":"article"},"doc://SKHelperUI/tutorials/quickstart/Check-a-purchase":{"kind":"article","type":"topic","identifier":"doc:\/\/SKHelperUI\/tutorials\/quickstart\/Check-a-purchase","abstract":[],"url":"\/tutorials\/quickstart\/check-a-purchase","title":"Check a purchase","role":"article"},"doc://SKHelperUI/tutorials/SKHelperUI/configure-products#Configuring-Productsplist":{"kind":"section","type":"section","identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/configure-products#Configuring-Productsplist","abstract":[{"text":"See how to configure in-app purchase products and Xcode purchase testing.","type":"text"}],"url":"\/tutorials\/skhelperui\/configure-products#Configuring-Productsplist","title":"Configuring Products.plist","role":"pseudoSymbol"},"quickstart-flowers1.swift":{"type":"file","fileType":"swift","identifier":"quickstart-flowers1.swift","content":["import SwiftUI","import StoreKit","import SKHelperUI","","struct SmallFlowersView: View {","    @Environment(SKHelper.self) private var store","    @State private var hasProducts = false","    @State private var isPurchased = false","    @State private var product: Product?","    private let smallFlowersProductId = \"com.rarcher.nonconsumable.flowers.small\"","    ","    var body: some View {","        if hasProducts {","            if isPurchased { FullAccess() }","            else { NoAccess() }","            ","        } else {","            ","            VStack {","                Text(\"No products available\").font(.subheadline).padding()","                Button(\"Refresh Products\") { Task { await store.requestProducts() }}","                ProgressView()","            }","            .padding()","            .onProductsAvailable { _  in","                hasProducts = store.hasProducts","                if hasProducts {","                    Task { isPurchased = await store.isPurchased(productId: smallFlowersProductId) }","                }","            }","        }","    }","    ","    func FullAccess() -> some View {","        VStack {","            Text(\"🥰 🌹\").font(.system(size: 100)).padding()","            Text(\"You've purchased the small flowers - here they are, enjoy!\").padding()","            Image(smallFlowersProductId).resizable().scaledToFit()","        }","        .padding()","    }","    ","    func NoAccess() -> some View {","        ","        VStack {","            Text(\"😢\").font(.system(size: 100)).padding()","            Text(\"You haven't purchased the small flowers and don't have access.\").padding()","            ","            if let product {","                Button(\"Purchase Small Flowers for \\(product.displayPrice)\") {","                    Task {","                        let result = await store.purchase(product)","                        if result.purchaseState == .purchased { isPurchased = true }","                    }","                }","                .tint(.blue)","            }","        }","        .padding()","        .task { product = store.product(from: smallFlowersProductId) }","    }","}"],"highlights":[],"fileName":"SmallFlowersView.swift","syntax":"swift"},"doc://SKHelperUI/tutorials/SKHelperUI/getting-started#Adding-the-SKHelper-package":{"kind":"section","type":"section","identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/getting-started#Adding-the-SKHelper-package","abstract":[{"type":"text","text":"How to get started with "},{"inlineContent":[{"type":"text","text":"SKHelper"}],"type":"strong"},{"type":"text","text":" by creating a simple demo app using SwiftUI."}],"url":"\/tutorials\/skhelperui\/getting-started#Adding-the-SKHelper-package","title":"Adding the SKHelper package","role":"pseudoSymbol"}}}