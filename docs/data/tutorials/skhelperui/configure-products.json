{"sections":[{"content":[{"inlineContent":[{"type":"text","text":"See how to configure in-app purchase products and Xcode purchase testing."}],"type":"paragraph"}],"estimatedTimeInMinutes":5,"title":"Configure products","chapter":"Configure products","xcodeRequirement":"Xcode 16.3+","kind":"hero"},{"tasks":[{"anchor":"Configuring-Productsplist","stepsSection":[{"content":[{"inlineContent":[{"text":"When our demo app runs it will need to get ","type":"text"},{"inlineContent":[{"type":"text","text":"localized"}],"type":"emphasis"},{"text":" product information from the App Store. This includes","type":"text"},{"text":" ","type":"text"},{"text":"things like the product’s name and description in the appropriate local language, and prices in the local currency.","type":"text"},{"text":" ","type":"text"},{"text":"In order to request localized product information we must provide the App Store with a collection of ","type":"text"},{"inlineContent":[{"type":"text","text":"Product Ids"}],"type":"emphasis"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"To avoid having to hard-code these ids in the app’s source "},{"type":"strong","inlineContent":[{"text":"SKHelper","type":"text"}]},{"type":"text","text":" allows us to store them in an easily modifiable"},{"text":" ","type":"text"},{"text":"property list (.plist) file.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"type":"text","text":"The diagram shows how product ids are used to request localized product information. In production the App Store will"},{"type":"text","text":" "},{"type":"text","text":"provide the information. During development and testing we can transparently provide the information from the"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Products.storekit"}]},{"type":"text","text":" file (more of this shortly)."}],"type":"paragraph"}],"code":null,"runtimePreview":null,"media":"quickstart7.png","type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"Create a new "},{"inlineContent":[{"text":"Property List","type":"text"}],"type":"strong"},{"type":"text","text":" file in your project and name it "},{"inlineContent":[{"type":"text","text":"Products.plist"}],"type":"strong"},{"text":". Right-click on ","type":"text"},{"inlineContent":[{"text":"Products.plist","type":"text"}],"type":"strong"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"and select "},{"inlineContent":[{"text":"Open As > Source Code","type":"text"}],"type":"strong"},{"text":". Now paste the contents of the example ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.plist"}],"type":"strong"},{"text":" file shown into your","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.list"}],"type":"strong"},{"text":" file.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"quickstart-products.plist","runtimePreview":null,"media":null,"type":"step"},{"content":[{"inlineContent":[{"text":"Now create a new ","type":"text"},{"inlineContent":[{"type":"text","text":".storekit"}],"type":"strong"},{"text":" file in your project and name it ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.storekit"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[],"code":null,"runtimePreview":null,"media":"quickstart9.png","type":"step"},{"content":[{"inlineContent":[{"text":"Right-click on ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.storekit"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"type":"text","text":"Open As > Source Code"}],"type":"strong"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Paste the contents of the example ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.storekit"}],"type":"strong"},{"text":" file shown into your ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.list"}],"type":"strong"},{"text":" file.","type":"text"}],"type":"paragraph"}],"caption":[],"code":"quickstart-products.storekit","runtimePreview":null,"media":null,"type":"step"},{"content":[{"inlineContent":[{"text":"If you now right-click on ","type":"text"},{"inlineContent":[{"type":"text","text":"Products.storekit"}],"type":"strong"},{"text":" and select ","type":"text"},{"inlineContent":[{"type":"text","text":"Open As > StoreKit Configuration"}],"type":"strong"},{"text":" you’ll","type":"text"},{"text":" ","type":"text"},{"text":"get a better view of the sort of configuration properties the ","type":"text"},{"inlineContent":[{"type":"text","text":".storekit"}],"type":"strong"},{"text":" file provides.","type":"text"}],"type":"paragraph"}],"caption":[],"code":null,"runtimePreview":null,"media":"quickstart8.png","type":"step"}],"title":"Configuring Products.plist","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In this section we’ll create the following product configuration files:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Products.plist","type":"text"}],"type":"strong"},{"type":"text","text":" which provides a collection of product ids"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Products.storekit","type":"text"}]},{"type":"text","text":" which provides localized product information during Xcode StoreKit testing"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"We’ll also add product images to the demo project."}]}],"mediaPosition":"trailing","kind":"contentAndMedia","media":"quickstart7.png"}]},{"anchor":"Configuring-product-images","stepsSection":[{"content":[{"inlineContent":[{"text":"In the ","type":"text"},{"inlineContent":[{"type":"text","text":"SKHelper"}],"type":"strong"},{"text":" package, navigate to the ","type":"text"},{"inlineContent":[{"type":"text","text":"Samples\/Images"}],"type":"strong"},{"text":" folder. Select all the images then right-click them","type":"text"},{"text":" ","type":"text"},{"text":"and select ","type":"text"},{"inlineContent":[{"type":"text","text":"Show in Finder"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}],"caption":[],"code":null,"runtimePreview":null,"media":null,"type":"step"},{"content":[{"inlineContent":[{"text":"Drag all the images from Finder into your project’s asset catalog.","type":"text"}],"type":"paragraph"}],"caption":[{"inlineContent":[{"text":"Notice that each image has the same filename as its associated product id.","type":"text"}],"type":"paragraph"}],"code":null,"runtimePreview":null,"media":"quickstart10.png","type":"step"}],"title":"Configuring product images","contentSection":[{"content":[{"inlineContent":[{"text":"In this section we’ll create the images for each of the products our app will make available for purchase.","type":"text"}],"type":"paragraph"}],"mediaPosition":"trailing","kind":"contentAndMedia","media":"quickstart10.png"}]}],"kind":"tasks"},{"action":{"identifier":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/display-products","isActive":true,"type":"reference","overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"overridingTitle":"Get started"},"abstract":[{"type":"text","text":"Add code to display all products and support user purchases."}],"title":"Display all products","featuredEyebrow":"Tutorial","kind":"callToAction"}],"kind":"project","hierarchy":{"reference":"doc:\/\/SKHelperUI\/tutorials\/quickstart","modules":[{"projects":[{"sections":[{"reference":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/getting-started#Adding-the-SKHelper-package","kind":"task"}],"reference":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/getting-started"}],"reference":"doc:\/\/SKHelperUI\/tutorials\/quickstart\/Getting-started"},{"projects":[{"sections":[{"reference":"doc:\/\/SKHelperUI\/tutorials\/SKHelperUI\/configure-products#Configuring-Productsplist","kind":"