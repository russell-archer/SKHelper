{"abstract":[{"text":"Checks the current entitlement for ","type":"text"},{"code":"productId","type":"codeVoice"},{"text":" to see if the user is entitled to use the product. A user may be","type":"text"},{"text":" ","type":"text"},{"text":"subscribed to more than one subscription product in the same group, so a check is also made to ensure the product","type":"text"},{"text":" ","type":"text"},{"text":"identified by ","type":"text"},{"code":"productId","type":"codeVoice"},{"text":" is the highest value product currently subscribed to in the subscription group. If both","type":"text"},{"text":" ","type":"text"},{"text":"checks are positive then true is returned, false otherwise.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SKHelperCore\/documentation\/SKHelperCore","doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper"]]},"metadata":{"title":"isSubscribed(productId:)","platforms":[{"beta":false,"introducedAt":"17.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"14.6","deprecated":false,"name":"macOS","unavailable":false}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSubscribed"},{"kind":"text","text":"("},{"kind":"externalParam","text":"productId"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ProductId","preciseIdentifier":"s:12SKHelperCore9ProductIda"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"SKHelperSubscriptionState","preciseIdentifier":"s:12SKHelperCore0A17SubscriptionStateO"}],"externalID":"s:12SKHelperCore0A0C12isSubscribed9productIdAA0A17SubscriptionStateOSS_tYaF","roleHeading":"Instance Method","symbolKind":"method","role":"symbol","modules":[{"name":"SKHelperCore"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSubscribed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"productId","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/ProductId","text":"ProductId","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore9ProductIda"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelperSubscriptionState","text":"SKHelperSubscriptionState","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore0A17SubscriptionStateO"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"productId","content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ProductId"},{"type":"text","text":" to check."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns "},{"type":"codeVoice","code":"SKHelperSubscriptionState.subscribed"},{"type":"text","text":" if user is entitled to use the product."}]}]},{"content":[{"level":2,"text":"Note","anchor":"Note","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is intended only for "},{"inlineContent":[{"type":"text","text":"auto-renewable subscriptions"}],"type":"strong"},{"text":". If ","type":"text"},{"code":"productId","type":"codeVoice"},{"text":" identifies any other type of product","type":"text"},{"text":" ","type":"text"},{"text":"then ","type":"text"},{"code":".notSubscribed","type":"codeVoice"},{"type":"text","text":" is returned."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the process of determining if a product is purchased can be unreliable. Calls to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" mostly produce the correct result. However, in both the Xcode testing"},{"type":"text","text":" "},{"type":"text","text":"and live production environments it is quite common for "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" to erroneously"},{"type":"text","text":" "},{"type":"text","text":"return no transactions, indicating the user has not purchased the product."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also, calling "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" can (seemingly randomly) result one of the following errors:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"UIDevice.current.identifierForVendor"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"AppStore.deviceVerificationID"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Domain=ASDErrorDomain Code=500 “(null)”"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any of the above errors result in an invalid result for the current entitlement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of theses inconsistencies we maintain a "},{"type":"codeVoice","code":"SKHelperProduct"},{"type":"text","text":" collection which contains a cached value"},{"text":" ","type":"text"},{"type":"text","text":"for the user’s entitlement to use each product."}]},{"type":"paragraph","inlineContent":[{"text":"When checking the purchased state of a subscription product we:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"check the return of "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"check ","type":"text"},{"code":"SKHelperProduct.hasEntitlement","type":"codeVoice"},{"text":" if ","type":"text"},{"code":"Transaction.currentEntitlements(for:)","type":"codeVoice"},{"text":" is nil and ","type":"text"},{"code":"useCachedEntitlements","type":"codeVoice"},{"text":" is true","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"check if the product is the highest value product subscribed to in the subscription group","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Important","anchor":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that when checking the value of a product within a subscription group the product with the highest value will"},{"type":"text","text":" "},{"type":"text","text":"have the "},{"type":"strong","inlineContent":[{"type":"text","text":"lowest"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Product.subscription.groupLevel"},{"type":"text","text":" value."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, if we setup subscription products in the .storekit configuration file (or App Store Connect) like this:"}]},{"type":"codeListing","code":["Level   ProductId","1       com.rarcher.subscription.vip.gold       - This product has the highest value","2       com.rarcher.subscription.vip.silver","3       com.rarcher.subscription.vip.bronze     - This product has the lowest value"],"syntax":null},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Returns ","type":"text"},{"code":"SKHelperSubscriptionState.notSubscribed","type":"codeVoice"},{"text":" if the product is not an auto-renewable subscription, or if an activate subscription to this product is not been found.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Returns "},{"type":"codeVoice","code":"SKHelperSubscriptionState.notVerified"},{"type":"text","text":" if the user has to have an entitlement to use the product but we couldn’t verify the transaction."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Returns "},{"type":"codeVoice","code":"SKHelperSubscriptionState.superceeded"},{"type":"text","text":" if the subscription to this product has been superceeded by a subscription with a higher value product in the same subscription group."}],"type":"paragraph"}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper\/isSubscribed(productId:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skhelpercore\/skhelper\/issubscribed(productid:)"]}],"references":{"doc://SKHelperCore/documentation/SKHelperCore/SKHelperSubscriptionState":{"abstract":[{"type":"text","text":"The state of a subscription."}],"title":"SKHelperSubscriptionState","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SKHelperSubscriptionState","kind":"identifier"}],"navigatorTitle":[{"text":"SKHelperSubscriptionState","kind":"identifier"}],"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelperSubscriptionState","url":"\/documentation\/skhelpercore\/skhelpersubscriptionstate","kind":"symbol","type":"topic","role":"symbol"},"doc://SKHelperCore/documentation/SKHelperCore":{"abstract":[],"kind":"symbol","role":"collection","type":"topic","title":"SKHelperCore","identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore","url":"\/documentation\/skhelpercore"},"doc://SKHelperCore/documentation/SKHelperCore/SKHelper":{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SKHelper"}],"navigatorTitle":[{"kind":"identifier","text":"SKHelper"}],"title":"SKHelper","abstract":[{"type":"text","text":"SKHelper, a lightweight StoreKit helper."}],"url":"\/documentation\/skhelpercore\/skhelper"},"doc://SKHelperCore/documentation/SKHelperCore/SKHelper/isSubscribed(productId:)":{"abstract":[{"type":"text","text":"Checks the current entitlement for "},{"type":"codeVoice","code":"productId"},{"type":"text","text":" to see if the user is entitled to use the product. A user may be"},{"type":"text","text":" "},{"type":"text","text":"subscribed to more than one subscription product in the same group, so a check is also made to ensure the product"},{"type":"text","text":" "},{"type":"text","text":"identified by "},{"type":"codeVoice","code":"productId"},{"type":"text","text":" is the highest value product currently subscribed to in the subscription group. If both"},{"type":"text","text":" "},{"type":"text","text":"checks are positive then true is returned, false otherwise."}],"title":"isSubscribed(productId:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isSubscribed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"productId","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProductId","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore9ProductIda"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"SKHelperSubscriptionState","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore0A17SubscriptionStateO"}],"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper\/isSubscribed(productId:)","url":"\/documentation\/skhelpercore\/skhelper\/issubscribed(productid:)","kind":"symbol","type":"topic","role":"symbol"},"doc://SKHelperCore/documentation/SKHelperCore/ProductId":{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/ProductId","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ProductId"}],"url":"\/documentation\/skhelpercore\/productid","abstract":[{"type":"text","text":"The unique id that identifies a product."}],"role":"symbol","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProductId","kind":"identifier"}],"title":"ProductId"}}}