{"abstract":[{"type":"text","text":"Checks the current entitlement for "},{"code":"productId","type":"codeVoice"},{"type":"text","text":" and returns true if the user is entitled to use the product,"},{"text":" ","type":"text"},{"text":"false otherwise.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/SKHelperCore\/documentation\/SKHelperCore","doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper"]]},"metadata":{"modules":[{"name":"SKHelperCore"}],"role":"symbol","symbolKind":"method","roleHeading":"Instance Method","externalID":"s:12SKHelperCore0A0C11isPurchased9productIdSbSS_tYaF","platforms":[{"beta":false,"introducedAt":"17.0","deprecated":false,"name":"iOS","unavailable":false},{"beta":false,"introducedAt":"14.6","deprecated":false,"name":"macOS","unavailable":false}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"isPurchased"},{"kind":"text","text":"("},{"kind":"externalParam","text":"productId"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12SKHelperCore9ProductIda","kind":"typeIdentifier","text":"ProductId"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isPurchased(productId:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"isPurchased"},{"text":"(","kind":"text"},{"text":"productId","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProductId","identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/ProductId","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore9ProductIda"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ProductId"},{"type":"text","text":" to check."}]}],"name":"productId"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns true if user is entitled to use the product, false otherwise."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method is intended for consumable and non-comsumable products. If "},{"type":"codeVoice","code":"productId"},{"type":"text","text":" identifies an auto-renewable"},{"type":"text","text":" "},{"type":"text","text":"subscription then we redirect the call to "},{"type":"codeVoice","code":"isSubscribed(productId)"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Notes on non-consumable products","anchor":"Notes-on-non-consumable-products"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note that the process of determining if a product is purchased can be unreliable. Calls to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" mostly produce the correct result. However, in both the Xcode testing"},{"type":"text","text":" "},{"type":"text","text":"and live production environments it is quite common for "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" to erroneously"},{"type":"text","text":" "},{"type":"text","text":"return noo transactions, indicating the user has not purchased the product."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Also, calling "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" can (seemingly randomly) result one of the following errors:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"UIDevice.current.identifierForVendor"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"AppStore.deviceVerificationID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain=ASDErrorDomain Code=500 “(null)”"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any of the above errors result in an invalid result for the current entitlement."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because of theses inconsistencies we maintain a "},{"type":"codeVoice","code":"SKHelperProduct"},{"type":"text","text":" collection which contains a cached value"},{"type":"text","text":" "},{"type":"text","text":"for the user’s entitlement to use each product."}]},{"type":"paragraph","inlineContent":[{"text":"When checking the purchased state of a product we return true if ","type":"text"},{"code":"Transaction.currentEntitlements(for:)","type":"codeVoice"},{"type":"text","text":" returns"},{"text":" ","type":"text"},{"type":"text","text":"a valid transaction. If the result is nil then if "},{"type":"codeVoice","code":"useCachedEntitlements"},{"type":"text","text":" is true we return the value of "},{"type":"codeVoice","code":"SKHelperProduct.hasEntitlement"},{"type":"text","text":"."}]},{"anchor":"Notes-on-consumable-products","level":2,"type":"heading","text":"Notes on consumable products"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Consumables don’t have entitlements, so "},{"type":"codeVoice","code":"Transaction.currentEntitlements(for:)"},{"type":"text","text":" returns no transactions."},{"type":"text","text":" "},{"type":"text","text":"However, the following do return transactions for both finished and unfinished consumables in iOS18+ and macOS15+"},{"type":"text","text":" "},{"type":"text","text":"(you also need to add "},{"code":"SKIncludeConsumableInAppPurchaseHistory = YES","type":"codeVoice"},{"type":"text","text":" to your app’s info.plist file):"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"all"},{"type":"text","text":" sequence in "},{"type":"codeVoice","code":"Transaction"},{"type":"text","text":"  - returns the user’s complete transaction history"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"latest(for:)"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Transaction"},{"type":"text","text":"  - returns the user’s most recent transaction for a specific product"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"latestTransaction"},{"type":"text","text":" in "},{"type":"codeVoice","code":"Product"},{"type":"text","text":" - returns the user’s most recent transaction for a specific product"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The user may purchase multiple instances of the same consumable product. However, ","type":"text"},{"code":"SKHelper","type":"codeVoice"},{"text":" must call ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" on each consumable","type":"text"},{"text":" ","type":"text"},{"text":"transaction as they happen, otherwise StoreKit prevents us from purchasing another instance (actually, the purchase appears to","type":"text"},{"text":" ","type":"text"},{"text":"work, but StoreKit just resends the most recent transaction for that product and the user is not charged for a new purchase).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note that we can’t tell if a consumable has “expired”, the host app must do this according to its own internal logic.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"As far as telling if a consumable has been purchased, all we can do is see if there has been at least one historical purchase","type":"text"},{"text":" ","type":"text"},{"text":"using ","type":"text"},{"code":"Product.product.latestTransaction","type":"codeVoice"},{"text":". We could use the ","type":"text"},{"code":"Transaction.all","type":"codeVoice"},{"text":" sequence to see how many purchases of the consumable","type":"text"},{"text":" ","type":"text"},{"text":"there have been, but that isn’t particularly useful.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"url":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper\/isPurchased(productId:)","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/skhelpercore\/skhelper\/ispurchased(productid:)"]}],"references":{"doc://SKHelperCore/documentation/SKHelperCore/ProductId":{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/ProductId","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ProductId"}],"url":"\/documentation\/skhelpercore\/productid","abstract":[{"type":"text","text":"The unique id that identifies a product."}],"role":"symbol","kind":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProductId","kind":"identifier"}],"title":"ProductId"},"doc://SKHelperCore/documentation/SKHelperCore":{"abstract":[],"kind":"symbol","role":"collection","type":"topic","title":"SKHelperCore","identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore","url":"\/documentation\/skhelpercore"},"doc://SKHelperCore/documentation/SKHelperCore/SKHelper/isPurchased(productId:)":{"abstract":[{"type":"text","text":"Checks the current entitlement for "},{"type":"codeVoice","code":"productId"},{"type":"text","text":" and returns true if the user is entitled to use the product,"},{"type":"text","text":" "},{"type":"text","text":"false otherwise."}],"kind":"symbol","role":"symbol","type":"topic","title":"isPurchased(productId:)","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"isPurchased","kind":"identifier"},{"text":"(","kind":"text"},{"text":"productId","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"ProductId","kind":"typeIdentifier","preciseIdentifier":"s:12SKHelperCore9ProductIda"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper\/isPurchased(productId:)","url":"\/documentation\/skhelpercore\/skhelper\/ispurchased(productid:)"},"doc://SKHelperCore/documentation/SKHelperCore/SKHelper":{"identifier":"doc:\/\/SKHelperCore\/documentation\/SKHelperCore\/SKHelper","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SKHelper"}],"navigatorTitle":[{"kind":"identifier","text":"SKHelper"}],"title":"SKHelper","abstract":[{"type":"text","text":"SKHelper, a lightweight StoreKit helper."}],"url":"\/documentation\/skhelpercore\/skhelper"}}}