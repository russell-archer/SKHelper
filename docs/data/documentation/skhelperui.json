{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The package is split into two library products:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Product"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Import"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use case"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SKHelperUI","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"import SKHelperUI","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI and StoreKit Views integration built on top of "},{"code":"SKHelperCore","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SKHelperCore","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"import SKHelperCore","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"StoreKit 2 product loading, purchase, entitlement, transaction, subscription, and cache logic without SwiftUI views."}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"SKHelperUI","type":"codeVoice"},{"text":" when you want the built-in SwiftUI views, view modifiers, product buttons, and StoreKit Views wrappers. Use ","type":"text"},{"code":"SKHelperCore","type":"codeVoice"},{"text":" directly when your app has a custom paywall or purchase UI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"SKHelperUI","type":"codeVoice"},{"text":" re-exports ","type":"text"},{"code":"SKHelperCore","type":"codeVoice"},{"text":", so SwiftUI clients only need ","type":"text"},{"code":"import SKHelperUI","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Features","anchor":"Features"},{"type":"unorderedList","items":[{"content":[{"type":"para